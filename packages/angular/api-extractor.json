/**
 * API report of @gantryjs/angular: `etc/gantryjs-angular.api.md`, read from the d.ts bundle of `pnpm build:lib`.
 *   pnpm api:angular         regenerate the report after a deliberate public change
 *   pnpm api:angular:check   fail when the built d.ts no longer matches the report (CI)
 * Generated file: never hand-merge it, rebuild and regenerate.
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": ".",
  "mainEntryPointFilePath": "<projectFolder>/../../dist/gantryjs-angular/types/gantryjs-angular.d.ts",
  "bundledPackages": [],
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.api.json"
  },
  "apiReport": {
    "enabled": true,
    "reportFileName": "gantryjs-angular",
    "reportFolder": "<projectFolder>/etc/",
    "reportTempFolder": "<projectFolder>/../../node_modules/.cache/api-extractor/gantryjs-angular/"
  },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false },
  "messages": {
    "compilerMessageReporting": {
      "default": { "logLevel": "warning" }
    },
    "extractorMessageReporting": {
      "default": { "logLevel": "warning" },
      "ae-missing-release-tag": { "logLevel": "none" },
      // Internal types reached from the API (protected template members typed with internal services,
      // the built-in bars' base class): listed in the report for review instead of failing
      "ae-forgotten-export": { "logLevel": "none", "addToApiReportFile": true }
    },
    "tsdocMessageReporting": {
      "default": { "logLevel": "none" }
    }
  }
}
