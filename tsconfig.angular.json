{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "importHelpers": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "ngx-gantry": ["./packages/angular/src/public-api.ts"],
      "@gantry/core": ["./packages/core/src/index.ts"],
      "@gantry/core/demo": ["./packages/core/src/demo.ts"],
      "@gantry/vanilla/package.json": ["./packages/vanilla/package.json"],
      "@gantry/vanilla/custom-elements.json": ["./packages/vanilla/custom-elements.json"],
      "demo-kit/*": ["./apps/demo-kit/src/*"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "extendedDiagnostics": { "defaultCategory": "error" }
  }
}
