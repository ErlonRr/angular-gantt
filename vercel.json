{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm exec ng build gantry-demo --configuration production --base-href /",
  "outputDirectory": "dist/gantry-demo/browser",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
