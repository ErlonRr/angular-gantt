{
  "name": "@gantry/svelte",
  "version": "1.0.0",
  "description": "Gantry Gantt chart for Svelte 5 — a free, full-featured interactive Gantt component.",
  "keywords": [
    "svelte",
    "svelte5",
    "svelte-component",
    "gantt",
    "gantt-chart",
    "timeline",
    "project-management",
    "roadmap",
    "schedule",
    "critical-path",
    "svg"
  ],
  "homepage": "https://github.com/ErlonRr/angular-gantt/tree/main/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/ErlonRr/angular-gantt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErlonRr/angular-gantt.git",
    "directory": "packages/svelte"
  },
  "license": "MIT",
  "author": "Erlon Rrustemaj",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@gantry/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@gantry/vanilla": "workspace:^",
    "@gantry/core": "workspace:^"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.8.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "svelte": "./dist/index.js"
}
