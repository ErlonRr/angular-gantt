{
  "name": "gantry-workspace",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "overrides": {
      "webpack": "5.106.2"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve gantry-demo --open",
    "build:lib": "ng build gantry",
    "build:app": "ng build gantry-demo --configuration production",
    "build:demo": "ng build gantry-demo --configuration production --base-href ./",
    "watch:lib": "ng build gantry --watch",
    "storybook": "ng run gantry-demo:storybook",
    "build:storybook": "ng run gantry-demo:build-storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ng lint",
    "dev:angular": "ng serve gantry-demo --open",
    "dev:vanilla": "pnpm --filter demo-vanilla dev",
    "dev:react": "pnpm --filter demo-react dev",
    "dev:vue": "pnpm --filter demo-vue dev",
    "dev:svelte": "pnpm --filter demo-svelte dev"
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "dayjs": "^1.11.13",
    "puppeteer": "^25.5.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@chromatic-com/storybook": "^5.1.2",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/angular": "^10.3.5",
    "ng-packagr": "^20.0.0",
    "storybook": "^10.3.5",
    "typescript": "~5.8.0",
    "vitest": "^4.1.10"
  }
}
