{
  "name": "ngx-gantt-workspace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "overrides": {
      "webpack": "5.106.2"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve erru-gantt-ng --open",
    "build:lib": "ng build ngx-gantt",
    "build:app": "ng build erru-gantt-ng --configuration production",
    "watch:lib": "ng build ngx-gantt --watch",
    "storybook": "ng run erru-gantt-ng:storybook",
    "build:storybook": "ng run erru-gantt-ng:build-storybook",
    "test": "ng test",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "dayjs": "^1.11.13",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@chromatic-com/storybook": "^5.1.2",
    "@storybook/angular": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "ng-packagr": "^20.0.0",
    "storybook": "^10.3.5",
    "typescript": "~5.8.0"
  }
}
