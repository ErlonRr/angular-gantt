{
  "name": "gantry-workspace",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ],
    "overrides": {
      "@jridgewell/sourcemap-codec": "^1.6.0"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve gantry-demo --open",
    "build:lib": "ng build gantry && node scripts/resolve-workspace-deps.mjs dist/gantryjs-angular/package.json",
    "build:app": "ng build gantry-demo --configuration production",
    "build:demo": "ng build gantry-demo --configuration production --base-href ./",
    "watch:lib": "ng build gantry --watch",
    "test": "vitest run && ng test gantry --watch=false",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:angular": "ng serve gantry-demo --open",
    "dev:vanilla": "pnpm --filter demo-vanilla dev",
    "dev:react": "pnpm --filter demo-react dev",
    "dev:vue": "pnpm --filter demo-vue dev",
    "dev:svelte": "pnpm --filter demo-svelte dev",
    "build": "pnpm build:packages && pnpm build:lib && pnpm build:app && pnpm build:demos",
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "build:demos": "pnpm --filter \"./apps/*\" -r build",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" -r typecheck && tsc -p tsconfig.json && tsc -p packages/angular/tsconfig.json && tsc -p apps/demo-angular/tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && pnpm build:lib && changeset publish",
    "test:tz": "TZ=America/Los_Angeles vitest run --project core && TZ=Asia/Kolkata vitest run --project core && TZ=Australia/Lord_Howe vitest run --project core",
    "qa:serve": "bash scripts/qa/serve.sh",
    "e2e": "playwright test",
    "e2e:full": "pnpm build && playwright test",
    "e2e:visual": "bash scripts/e2e-container.sh e2e/visual.spec.ts",
    "e2e:update": "bash scripts/e2e-container.sh e2e/visual.spec.ts --update-snapshots=all",
    "test:angular": "ng test gantry --watch=false",
    "api:angular": "api-extractor run --local -c packages/angular/api-extractor.json",
    "api:angular:check": "api-extractor run -c packages/angular/api-extractor.json",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "catalog:",
    "@playwright/test": "^1.64.0",
    "dayjs": "^1.11.13",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.1",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "happy-dom": "^20.14.5",
    "ng-packagr": "catalog:",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.1",
    "vitest": "catalog:",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
