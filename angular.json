{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "analytics": false
  },
  "projects": {
    "ngx-gantt": {
      "projectType": "library",
      "root": "projects/ngx-gantt",
      "sourceRoot": "projects/ngx-gantt/src",
      "prefix": "gantt",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ngx-gantt/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-gantt/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-gantt/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ngx-gantt/tsconfig.spec.json"
          }
        }
      }
    },
    "erru-gantt-ng": {
      "projectType": "application",
      "root": "projects/erru-gantt-ng",
      "sourceRoot": "projects/erru-gantt-ng/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/erru-gantt-ng",
            "index": "projects/erru-gantt-ng/src/index.html",
            "browser": "projects/erru-gantt-ng/src/main.ts",
            "polyfills": [],
            "tsConfig": "projects/erru-gantt-ng/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/erru-gantt-ng/src/assets",
                "output": "/assets"
              },
              "projects/erru-gantt-ng/src/favicon.ico"
            ],
            "styles": [
              "projects/erru-gantt-ng/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "erru-gantt-ng:build:production"
            },
            "development": {
              "buildTarget": "erru-gantt-ng:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "erru-gantt-ng:build:development",
            "configDir": ".storybook",
            "port": 6006,
            "compodoc": false
          },
          "configurations": {
            "production": {
              "browserTarget": "erru-gantt-ng:build:production"
            }
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "browserTarget": "erru-gantt-ng:build:production",
            "configDir": ".storybook",
            "outputDir": "storybook-static",
            "compodoc": false
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        }
      }
    }
  }
}
