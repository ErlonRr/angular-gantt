{
  "name": "gantry-workspace",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve gantry-demo --open",
    "build:lib": "ng build gantry && node scripts/resolve-workspace-deps.mjs dist/ngx-gantry/package.json",
    "build:app": "ng build gantry-demo --configuration production",
    "build:demo": "ng build gantry-demo --configuration production --base-href ./",
    "watch:lib": "ng build gantry --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ng lint",
    "dev:angular": "ng serve gantry-demo --open",
    "dev:vanilla": "pnpm --filter demo-vanilla dev",
    "dev:react": "pnpm --filter demo-react dev",
    "dev:vue": "pnpm --filter demo-vue dev",
    "dev:svelte": "pnpm --filter demo-svelte dev",
    "build": "pnpm build:packages && pnpm build:lib && pnpm build:app && pnpm build:demos",
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "build:demos": "pnpm --filter \"./apps/*\" -r build",
    "typecheck": "pnpm --filter \"./packages/*\" -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && pnpm build:lib && changeset publish",
    "test:tz": "TZ=America/Los_Angeles vitest run --project core && TZ=Asia/Kolkata vitest run --project core",
    "qa:serve": "bash scripts/qa/serve.sh",
    "e2e": "playwright test",
    "e2e:full": "pnpm build && playwright test",
    "e2e:visual": "bash scripts/e2e-container.sh e2e/visual.spec.ts",
    "e2e:update": "bash scripts/e2e-container.sh e2e/visual.spec.ts --update-snapshots=all"
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "dayjs": "^1.11.13",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.64.0",
    "happy-dom": "^20.14.5",
    "ng-packagr": "^20.0.0",
    "typescript": "~5.8.0",
    "vitest": "^4.1.10"
  }
}
